<div class="xtal-search-wrapper">
  <search-page limit="{{ section.settings.max_products }}">
    <div class="search-header">
      <div class="search-bar-container">
        <input class="search-input" type="text" placeholder="Find your product" />
        <button class="search-button">Search</button>
      </div>

      <div class="aspects-containers">
        <div id="active-aspects-container"></div>
        <div id="aspects-container"></div>
      </div>
    </div>

    {% comment %}<div class="popular-searches">{% endcomment %}
      {% comment %}<div class="aspects-title">Popular Searches</div>{% endcomment %}
      {% comment %}<div id="active-aspects-container" class="active-aspects"></div>{% endcomment %}
      {% comment %}<div id="aspects-container" class="suggested-aspects"></div>{% endcomment %}
    {% comment %}</div>{% endcomment %}

    <div class="refinements hidden">
      <div class="refinement-controls">
        <button>Men's & Women's</button>
        <button>All colors</button>
        <button>View all filters</button>
      </div>
      <div class="sort-dropdown">
        <label for="sort-select">Sort by</label>
        <select id="sort-select">
          <option value="featured">Featured</option>
          <option value="price_asc">Price (Low to High)</option>
          <option value="price_desc">Price (High to Low)</option>
        </select>
      </div>
    </div>

    <div class="results-section">
      <h2 class="results-heading">Here's what we found for you:</h2>
      <div class="results-container"></div>
    </div>
  </search-page>
</div>

{{ 'app.js' | asset_url | script_tag }}

<style>
  .xtal-search-wrapper {
    padding: 2rem;
    font-family: sans-serif;
    background-color: #fff;
  }

  .search-bar-container {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .search-input {
    flex: 1;
    padding: 0.75rem;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .search-button {
    background-color: #2c4fbb;
    color: white;
    padding: 0.75rem 1.25rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
  }

  .get-started-buttons button,
  .suggested-aspects label,
  .active-aspects label,
  .refinement-controls button {
    background: #f1f1f1;
    border: none;
    padding: 0.5rem 1rem;
    margin: 0.25rem;
    border-radius: 20px;
    cursor: pointer;
  }

  .active-aspects label {
    background-color: #2c4fbb;
    color: white;
  }

  .results-heading {
    margin-top: 2rem;
    font-size: 1.2rem;
  }

  .results-container {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .search-result-card {
    border: 1px solid #eee;
    border-radius: 6px;
    padding: 0.5rem;
    text-align: center;
  }

  .search-item-img-frame {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    margin-bottom: 0.5rem;
  }

  .search-item-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .search-item-price-container {
    margin-top: 0.5rem;
  }

  .search-item-price {
    font-weight: bold;
  }

  .sort-dropdown {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .aspects-containers {
    display: flex;
    width: 100%;
    gap: 1rem;
    margin: 1rem 0;
    flex-direction: column;
  }
  #aspects-container, #active-aspects-container {
    display: flex;
    width: 100%;
    gap: 1rem;
  }
  .aspects-containers label {
    cursor: pointer;
    border: 1px solid gray;
    padding: .5rem 1rem;
    border-radius: 1rem;
    display: flex;
    transition: all;
    align-items: center;
    max-height: fit-content;
    min-width: fit-content;
  }
  .aspects-containers label:hover {
    background-color: #80bbff;
    color: #FFF;
  }

  #active-aspects-container label {
    background-color: #0978f6;
    color: #FFF;
  }
</style>

{% schema %}
{
  "name": "XTAL Search",
  "target": "section",
  "javascript": "app.js",
  "settings": [
    {
      "type": "range",
      "id": "max_products",
      "label": "Max Products Per Page",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "pts",
      "default": 25
    }
  ]
}
{% endschema %}

