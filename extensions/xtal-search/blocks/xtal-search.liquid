<div class="search-container-wrap">
  <search-page limit="{{ section.settings.max_products }}">
    <div class="search-container">
        <input type="text" class="search-input" placeholder="Search..." />
        <button class="search-button">Search</button>
    </div>
    <div class="aspects-containers">
      <div id="active-aspects-container"></div>
      <div id="aspects-container"></div>
    </div>
    <div class="results-container"></div>
  </search-page>

</div>

<style>
  search-page {
    display: flex;
    margin: 20px auto;
    font-family: Arial, sans-serif;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
  }
  .search-container {
    display: flex;
    gap: 10px;
    max-width: 600px;
    width: 100%;
  }
  .aspects-containers {
    display: flex;
    width: 100%;
    gap: 1rem;
    margin: 1rem 0;
    flex-direction: column;
  }
  #aspects-container, #active-aspects-container {
    display: flex;
    width: 100%;
    gap: 1rem;
  }
  .aspects-containers label {
    cursor: pointer;
    border: 1px solid gray;
    padding: .5rem 1rem;
    border-radius: 1rem;
    display: flex;
    transition: all;
    align-items: center;
    max-height: fit-content;
    min-width: fit-content;
  }
  .aspects-containers label:hover {
    background-color: #80bbff;
    color: #FFF;
  }

  #active-aspects-container label {
    background-color: #0978f6;
    color: #FFF;
  }

  .search-input {
    flex-grow: 1;
    padding: 8px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .search-button {
    padding: 8px 12px;
    background: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .results-container {
    margin-top: 20px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .search-result-card {
    display: flex;
  }

  a.search-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    padding: 1rem;
  }

  a.search-link h3 {
    display: flex;
    width: 100%;
  }

  a.search-link .search-item-price-container {
    
  }

  a.search-link .search-item-price-container .search-item-price{
    color: rgb(var(--color-foreground));
  }

  .search-item-img-frame{
    display: flex;
    width: 100%;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .search-item-img {
    position: absolute;
    width: 100%;
  }

  .search-result{
    display: flex;
  }
  .search-link{
    display: flex;
    flex-direction: column;
  }

</style>

{% schema %}
{
  "name": "XTAL Search",
  "target": "section",
  "javascript": "app.js",
  "settings": [
    {
      "type": "range",
      "id": "max_products",
      "label": "Max Products Per Page",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "pts",
      "default": 25
    }
  ]
}
{% endschema %}

